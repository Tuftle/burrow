{
  "manifest_version": 2,
  "name": "Burrow",
  "version": "__VERSION__",
  "description": "A quiet password manager. Your logins live in one encrypted file, with no accounts.",
  "browser_specific_settings": { "gecko": { "id": "burrow@tuftle.vercel.app", "strict_min_version": "115.0" } },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "browser_action": { "default_title": "burrow", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "scripts": ["match.classic.js", "background.js"], "persistent": false },
  "permissions": ["storage", "alarms", "clipboardWrite"],
  "content_scripts": [
    { "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
  "commands": {
    "open": { "suggested_key": { "default": "Alt+Shift+V" }, "description": "Open burrow" },
    "fill": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "Fill this page's login" }
  }
}
